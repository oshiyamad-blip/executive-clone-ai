node_modules/
dist/
.env.local
.env
*.local

# 収集した経営者の生ログ・処理状態（極秘情報 — 絶対にコミットしない）
data/*
!data/.gitkeep

# Plaud NotePin S 等のライフログ取り込み用ドロップフォルダ
lifelog-inbox/*
!lifelog-inbox/.gitkeep

# LINE等のメッセンジャー・エクスポート取り込み用ドロップフォルダ
messenger-inbox/*
!messenger-inbox/.gitkeep

# 実行ログ
logs/*
!logs/.gitkeep

# 生成された成果物（機微情報を含むためコミットしない）
briefings/
digests/

# 鍵・証明書・環境ごとの設定（公開リポジトリに絶対にコミットしない。置き場はリポジトリの外を推奨）
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*service-account*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
secrets/

# 契約書・稼働の書き出し・リード等の取り込み用ドロップフォルダ（個人情報・単価を含む）
contracts-import/
engagements-import/
leads-import/

# 検証の作業用フォルダ
tmp/
# google-github-actions/auth が作業フォルダに書く一時的な資格情報
gha-creds-*.json
