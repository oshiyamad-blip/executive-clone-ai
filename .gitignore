node_modules/
dist/
.env.local
.env
*.local

# 収集した経営者の生ログ・処理状態（極秘情報 — 絶対にコミットしない）
data/*
!data/.gitkeep

# Plaud NotePin S 等のライフログ取り込み用ドロップフォルダ
lifelog-inbox/*
!lifelog-inbox/.gitkeep

# LINE等のメッセンジャー・エクスポート取り込み用ドロップフォルダ
messenger-inbox/*
!messenger-inbox/.gitkeep

# 実行ログ
logs/*
!logs/.gitkeep

# 生成された成果物（機微情報を含むためコミットしない）
briefings/
digests/

# バックテスト: 母集団の定義だけは追跡し、取得した価格や結果は追跡しない
!data/universe/
data/prices/
data/backtest*.json
data/backtest*.csv
