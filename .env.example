# ===== 必須 =====

# ===== LLMプロバイダ選択 =====
# anthropic（既定）または gemini。抽出・生成・対話すべてに使われる。
LLM_PROVIDER=anthropic

# --- Anthropic（Claude）を使う場合 ---
# 極秘情報を扱うため、ゼロデータリテンション(ZDR)を有効化したキーの使用を強く推奨。[Secret]
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Gemini を使う場合（LLM_PROVIDER=gemini）---
# (A) Google AI Studio の APIキー（無料枠は送った内容が品質改善・人による確認に使われ得るため、
#     SESマッチング（メール本文・社員のスキルシートを送る）の本番では、課金を有効にして利用条件を確認したうえで
#     SES_ALLOW_GEMINI_API=paid を設定する。未設定ならSESのバッチは始めない）
GEMINI_API_KEY=
# SES_ALLOW_GEMINI_API=paid
# GEMINI_MODEL=gemini-flash-latest   # AI Studio時の既定。高精度が要れば gemini-2.5-pro
#   ※ Vertex AI では `-latest` エイリアスが使えないため、既定は gemini-2.5-flash（版付き）になる
# (B) 企業/セキュア: Vertex AI（極秘データが自社GCP内に留まる・GWS親和）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Notion（シグナルDB・ストーリーDB） — Internal Integration Token(Bearer)
# 各DBに Connections からインテグレーションを共有すること。
NOTION_TOKEN=
# database_id を設定（起動時に data_source_id へ自動解決してキャッシュする）
NOTION_SIGNAL_DB_ID=
NOTION_STORY_DB_ID=

# ===== データソース（任意 — 未設定のソースはスキップされる） =====

# --- ライフログ: Plaud NotePin S ---
# 文字起こしファイル(.txt/.md/.srt/.vtt)を置く受け皿フォルダ。
# 供給経路: (1)公式Zapier「Transcript & Summary Ready」→Drive/Dropbox同期フォルダ
#           (2)非公式CLI `plaud sync <dir>` を日次cron  (3)アプリから手動エクスポート
LIFELOG_INBOX_DIR=./lifelog-inbox
# 取り込み後に _processed/ へ退避するか。既定 true（Plaudは録音ごとに一意ファイルが
# 増えるため退避が効率的）。Drive等の同期フォルダを使うなら false 推奨。
LIFELOG_ARCHIVE=true

# --- メッセンジャー: LINE ---
# LINE の「トーク履歴を送信」でエクスポートした .txt を置く受け皿フォルダ。
# （LINE には個人トークを読む公開APIが無いため手動エクスポート方式）
#
# 摩擦を減らすコツ: Google Drive / iCloud / Dropbox の「同期フォルダ」のパスを指定すると、
# スマホで「送信」→そのフォルダに保存するだけで取り込まれる（PCへのファイル移動が不要）。
# 例) MESSENGER_INBOX_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/LINE
MESSENGER_INBOX_DIR=./messenger-inbox
# 取り込んだファイルを _processed/ へ移動するか。既定 false（非破壊）。
# 同期フォルダでは false 推奨（毎回の全履歴再エクスポートでも日付単位で重複排除される）。
# ローカルの使い捨てフォルダで整理したい場合のみ true。
MESSENGER_ARCHIVE=false

# --- Slack ---
# search.messages 用。経営者本人のOAuth認可で発行したユーザートークン(xoxp-)が必要。
# 必要スコープ: search:read, users:read
SLACK_USER_TOKEN=
# 対象経営者の Slack ユーザーID（Uxxxx）
SLACK_TARGET_USER_ID=

# --- Google Workspace（Gmail / Calendar / Meet / Drive）---
# サービスアカウント + ドメイン全体委任（DWD）で対象経営者を impersonate する。
# Workspace管理コンソールでクライアントIDと readonly スコープを事前登録すること。
GOOGLE_SA_CLIENT_EMAIL=
# サービスアカウントの秘密鍵（改行は \n でエスケープして1行で記載）
GOOGLE_SA_PRIVATE_KEY=
# 上2つのかわりに、JSON鍵ファイルの中身を丸ごと1変数で渡してもよい（GitHub Secrets 向け。こちらが優先）。[Secret]
# SESマッチングでは、案件スプレッドシート・「プロパー管理」・スキルシートのフォルダをこのSAのメール（client_email）に共有して使う（DWD不要）
GOOGLE_SA_KEY_JSON=
# impersonate する対象経営者のメールアドレス
GOOGLE_TARGET_EMAIL=

# ===== 設定 =====

# 経営者の名前（対話表示・プロファイル用）
EXECUTIVE_NAME=代表取締役
# 経営者プロファイルの実際の内容（価値観・意思決定ルール・権限委譲・採用基準等）。src/data/executiveProfile.ts は
# 公開リポジトリで管理するサンプルのため書き換えず、data/executive-profile.json（コミットされない）か、
# ここに同じ項目名の1行の JSON を置く（書いた項目だけがサンプル値を置き換える）
# EXECUTIVE_PROFILE_JSON=

# シグナルとして採用する重要度のしきい値（1〜10）。これ未満は破棄。
SIGNAL_IMPORTANCE_THRESHOLD=5

# ===== アウトプット（任意） =====

# ブリーフィング/ダイジェストをNotionにも出力する場合の親ページID。
# 未設定ならローカルの briefings/ digests/ にMarkdownのみ出力。
NOTION_BRIEFING_PARENT_PAGE_ID=
NOTION_DIGEST_PARENT_PAGE_ID=

# --- Web対話UI（npm run web）---
WEB_HOST=127.0.0.1
WEB_PORT=8787
# 設定すると /api/* に Bearer 認証を要求（要件4.1: 経営幹部のみ）。
# ローカル以外に公開する場合は必ず設定すること。
WEB_ACCESS_TOKEN=

# ===== SES案件・要員マッチング（npm run ses / ses:demo） =====
# 詳細: docs/ses-matching-basic-design.md §9 / docs/ses-matching-detailed-design.md
# GitHub Actions で定時実行する場合は、このファイルではなくリポジトリの Settings → Secrets and variables → Actions に登録する
# （手順・一覧: docs/ses-deploy-github-actions.md）。下の [Secret] は Secrets、[Variable] は Variables に登録する項目。
# 公開リポジトリのため、値をこのファイルやワークフローに直接書いてコミットしないこと。
# 手元での確認: npm run ses:preflight（接続なしで設定の渡し漏れ・書式を確認）/ npm run doctor（接続まで確認）
# ANTHROPIC_API_KEY 未設定時は自動的にdemoモード（外部呼び出しなし）で動作する。
# ただし CI（GitHub Actions）上、または SES_REQUIRE_LIVE=true のときは、鍵が無ければdemoに切り替えずエラー終了する
# （Secretsの渡し忘れでfixtureの結果を「成功」として出さないため）。空の値（X=）は未設定として扱う。
# SES_REQUIRE_LIVE=

# --- メール送受信プロバイダ切替（収集・下書き作成・サマリ送信の「口」だけを差し替える） ---
# xserver（既定・IMAP/SMTP直結。Xserver単独運用向け）| gmail（Google Workspace API・DWD）
# 会社ドメインをGoogle Workspaceへ移行したら gmail に切り替えるだけで他は変更不要。
# [Variable] 未設定なら xserver
MAIL_PROVIDER=xserver
# [xserver] 共有メーリス(sales@)を置くメールサーバのIMAP/SMTP接続情報。Xserverはサーバーパネルの「メールソフト設定」にある
# svXXXX.xserver.jp（https:// やポート番号は付けない）。IMAP 993/SSL・SMTP 465/SSL
# [Secret] XSERVER_IMAP_HOST / XSERVER_SMTP_HOST  [Variable] ポート（通常は未設定のまま）
XSERVER_IMAP_HOST=
XSERVER_IMAP_PORT=993
XSERVER_SMTP_HOST=
XSERVER_SMTP_PORT=465
# [xserver] 共有メールボックス(sales@)のログインユーザ（メールアドレス全体）/パスワード。[Secret]
XSERVER_SHARED_USER=
XSERVER_SHARED_PASS=
# [xserver] 全員に返信の下書きをAPPENDする下書きフォルダ名（サーバの表記に合わせる。INBOX.Drafts 等）。[Variable]
# 実在するかは npm run doctor か npm run ses:mail-stats（GitHub Actions の「SESメール量の測定」）が確認する
XSERVER_DRAFTS_MAILBOX=Drafts
# 収集対象の遡り日数（xserver/gmail共通。旧名 XSERVER_COLLECT_DAYS も可）。既定7日。
# 重複は処理済みメールIDで除外されるため広めでよい（週末明けの実行や、抽出に失敗したメールの再試行が窓から外れないように。
# 窓の中の処理済みメールは本文を取得しないため、広げても取得量は増えない）。
# 次回の定時実行（平日10:00/14:00）の時点で窓を外れるメールは、失敗回数に関わらずその時点で隔離してサマリで知らせる
# （基盤障害で大半が失敗した回は隔離せず、異常終了として知らせる）。[Variable]
SES_COLLECT_DAYS=7
# 1回の実行で抽出する未処理メールの上限（次回に窓を外れるものを優先し、残りは新しい順。超過分は次回以降）。
# 本文は選んだメールだけ取得する。初回やバックログ時のコスト・時間を抑える [Variable]
SES_MAX_MAILS_PER_RUN=150
# 1回の実行で新しい抽出・判定を始めてよい時間（分。開始から）。メールの抽出はこの約半分までで区切り、残りの時間で必ず突合・通知を行う。
# 過ぎたら済んだ分を保存してサマリを送り、残りは次回に続きから（GitHub Actions のジョブの制限時間 40分より短くする）[Variable]
SES_RUN_DEADLINE_MINUTES=20
# 自社のメールドメイン（カンマ区切り）。ここから届いたメール（営業が共有メーリスをCcに入れた紹介メール等）は収集しない。
# 本バッチ自身の送信元と、サマリ・修復レポートの件名のメールは設定に関わらず除外する。
# 全員に返信の Cc でも「自社の宛先」の判定に使う（他社・配信用の宛先は Cc に引き継がない）。
# 下書きの送信元の許可（SES_ALLOWED_SENDER_DOMAINS 未設定時）にも使う
# [Secret]（会社を特定できる値のため。GitHub Actions の Variables は公開ログに表示される）
SES_OWN_DOMAINS=
# 自社ドメインからのメールも案件・要員として収集する（社内の営業が共有メーリスに案件を流す運用の場合のみ true）
SES_COLLECT_OWN_DOMAIN=false
# 通常バッチで、今回の新着と組み合わせる既存の募集中案件・提案可要員の遡り日数と上限件数（判定済みのペアは除外）
SES_MATCH_LOOKBACK_DAYS=14
# 再送スキップ: 同じ送信元ドメインが直近この日数に送った内容と同じメールは、抽出（API）を呼ばずにスキップ（0で無効）
SES_RESEND_WINDOW_DAYS=14
# 再送スキップの本文の近さ（0.8〜1。1で完全一致のみ）。本文の数字・添付・項目の見出し数が同じことも条件
SES_RESEND_SIMILARITY=0.9
SES_MATCH_POOL_LIMIT=500

# 価格の方針（粗利下限・交渉幅。社外に知られたくない方針）。[Secret・本番は必須]
# GitHub Actions では1行の JSON 1つで登録する（推測できない乱数 n を必ず含める。短い数値を個別の Secret にすると、
# Actions がログ全体の同じ数字を伏せ字にし、伏せ字の位置から値が分かってしまうため）。値は文書の例・既定値と違うものにする。
# 例: SES_PRICING_POLICY_JSON={"minGrossMarginMan":<粗利下限>,"projectRaiseMaxMan":<上げ幅>,"engineerCutMaxMan":<下げ幅>,"n":"<ランダムな20文字以上>"}
SES_PRICING_POLICY_JSON=
# 手元の実行では個別の設定も使える（JSON が優先）。粗利下限（円/月）。「案件単金上限 − 要員希望単金」がこれ未満のペアは除外
# （万円で書く場合は MIN_GROSS_MARGIN_MAN。こちらが優先）。GitHub Actions の Secrets には登録しない
MIN_GROSS_MARGIN_JPY=
# MIN_GROSS_MARGIN_MAN=
# [gmail] SES専用メールボックス（グループではなく実ユーザーのアドレス）。このユーザーとしてDWDで収集・サマリ送信する。
# DWDに登録するスコープは gmail.readonly / gmail.compose / gmail.send の3つ（下書きは担当者本人として gmail.compose で作成）
SES_TARGET_GMAIL=
# マッチング結果サマリ・診断レポートの通知先メールアドレス（カンマ区切りで複数可）。[Secret]
# GitHub Actions のログは秘匿されるため、失敗の詳細はこのメールで確認する（設定を強く推奨）。
# 社員・要員の情報が載るため、自社ドメイン（SES_OWN_DOMAINS・共有メールボックスのドメイン）以外の宛先には送らない
SES_NOTIFY_TO=
# true のときだけ、SES_NOTIFY_TO の社外のドメインの宛先にもサマリを送る（既定 false）
SES_NOTIFY_ALLOW_EXTERNAL=false
# 個人データの保存期間（日。既定180・30〜3650）。受信から過ぎた案件・要員・マッチ・プロパー候補・評価の行を削除する
SES_RETENTION_DAYS=180
# 下書きの送信元に使えるドメイン（カンマ区切り・完全一致）。スプレッドシートの「担当者メール」列と確認UIに適用。
# 空なら SES_OWN_DOMAINS と共有メールボックスのドメインだけ（どれも無ければ下書きを作らない）[Secret]
SES_ALLOWED_SENDER_DOMAINS=
# 下書きの送信元にしてよいアドレス（カンマ区切り）。設定するとこのアドレスだけを送信元にする。
# MAIL_PROVIDER=gmail では必須（DWDでその人のGmailに下書きを作るため、ドメインが合うだけの誰にでもなりすませないように）[Secret]
SES_ALLOWED_SENDERS=
# スプレッドシートの「下書きデータ」列と、案件・要員タブの「返信メタ」（下書きの宛先の元）・営業元メールの署名の鍵
# （ランダムな32文字以上）。シート上で宛先・本文を書き換えた行・別の行から写した値からは下書きを作らない。
# DB_PROVIDER=sheets の本番では必須（未設定・32文字未満の間は、担当者メールの依頼はすべてエラーにして下書きを作らない）。
# 最初の実行の前に設定する（後から設定すると、それまでに保存した案件・要員の行は宛先に使わず、未作成の下書きは作り直しが必要）[Secret]
SES_DRAFT_SIGNING_KEY=
# 1案件あたりLLM最終判定に回す候補ペアの上限（コスト上限の保証）
MAX_CANDIDATES_PER_ITEM=5
# 1回の突合で1名の要員を候補に入れる案件数の上限（単金の安い1名が多数の案件の上位を独占しないように。あふれた枠は次点で埋める）
MAX_PROJECTS_PER_ENGINEER=3
# 受信からこの日数を超えた案件・要員は成立候補にせず参考提案に下げ「要再確認」を付ける
SES_STALE_DAYS=45
# 必須スキル一致率の下限（0〜1・許容範囲の下端）。未満のペアは除外
SKILL_MATCH_THRESHOLD=0.6
# 「強マッチ」の下限（0〜1）。以上=成立候補、下限〜これ未満=参考提案バンド
SKILL_MATCH_STRONG_THRESHOLD=0.8
# 最終判定（AI）のスコアがこれ未満の成立候補・交渉提案は参考提案に下げる（自動の紹介下書きを作らない。0で無効）
MATCH_MIN_LLM_SCORE=60
# 最終判定（AI）のスコアがこれ未満の組は「不適合」（サマリは件数だけ・マッチタブに判定「不適合」で残す）。
# 商流・年齢等の即NG条件に反すると判定された組はスコアに関わらず不適合。0でスコアによる不適合を無効
MATCH_REJECT_LLM_SCORE=40
# 1回の実行でAI最終判定と紹介文面の生成に使うLLMコストの目安（円）。超えたら残りの組は「AI判定待ち」（判定「未判定」）で
# 保存し、次回の実行で判定する（下書きは判定の後）。0で上限なし
SES_JUDGE_BUDGET_JPY=300
# 時給→月額換算に使う月間稼働時間
HOURLY_TO_MONTHLY_HOURS=160
# 開始時期と稼働可能日の整合判定の猶予日数
MATCH_TIMING_GRACE_DAYS=30
# 交渉提案: 粗利が下限に届かないペアを、案件+X万・要員−Y万の交渉で成立させる提案を出すか
ENABLE_NEGOTIATION=true
# 交渉で案件単金を上げてもらう上限（万円/月。手元の実行用。Actions では SES_PRICING_POLICY_JSON の projectRaiseMaxMan）
NEGOTIATION_MAX_PROJECT_RAISE_MAN=
# 交渉で要員単金を下げてもらう上限（万円/月。手元の実行用。Actions では SES_PRICING_POLICY_JSON の engineerCutMaxMan）
NEGOTIATION_MAX_ENGINEER_CUT_MAN=
# --- データ保存先の切替 ---
# notion（既定）| sheets（Googleスプレッドシート。Notion不要になり、タブ・ヘッダーは自動生成）
# sheets の場合: 空のスプレッドシートを作成し、サービスアカウントのメールアドレス（client_email）に
# 「編集者」として共有して IDを下に設定（DWD不要）。処理済みメールID・隔離リストもこのシートに保存される
DB_PROVIDER=notion
# DB_PROVIDER=sheets のときのスプレッドシートID（URLの /d/ と /edit の間。URLのままでも可）。[Secret]
# GitHub Actions のワークフローは DB_PROVIDER=sheets 固定
SHEETS_DB_SPREADSHEET_ID=
# （任意）SAではなく特定ユーザーとして読み書きする場合のみ、そのユーザーのメールを設定（要DWD＋spreadsheetsスコープ）
# （組織外への共有が禁止されていてSAに共有できない場合の代替。社員のアドレスのため [Secret]）
SHEETS_DB_IMPERSONATE=

# --- プロパー（自社社員）のスキルシート → 案件候補（任意。下の2つを設定すると有効） ---
# スキルシート（PDF/Excel/Word(.docx)/Googleドキュメント・スプレッドシート）を置くDriveフォルダのID（URLでも可）
# [Secret]
PROPER_SKILLSHEET_FOLDER_ID=
# 管理表「プロパー管理」を置くスプレッドシートのID（URLでも可）。タブとヘッダーは自動生成。
# 人は「必要案件単価」「稼働状況（稼働可/アサイン済/対象外）」だけ入力する。候補は案件スプシの「プロパー候補」タブへ
# [Secret]
PROPER_MASTER_SPREADSHEET_ID=
# 既定はメインのサービスアカウント（GOOGLE_SA_*）で読む＝フォルダと管理表をそのSAのメールに共有するだけ。
# 別のGoogle Workspaceに置く場合のみ、そのテナント用のSA鍵を設定（JSON丸ごと、または EMAIL/PRIVATE_KEY）。[Secret]
PROPER_GOOGLE_SA_KEY_JSON=
PROPER_GOOGLE_SA_CLIENT_EMAIL=
PROPER_GOOGLE_SA_PRIVATE_KEY=
# （任意）SAへの共有が禁止されている場合のみ、DWDでなりすますユーザー（drive.readonly＋spreadsheets の委任が必要）。
# PROPER_GOOGLE_SA_*（そのテナントが発行したSA）と組み合わせたときだけ使う（メインのSAで別テナントをなりすまさない）[Secret]
PROPER_GOOGLE_IMPERSONATE=
# 1回の実行でLLM抽出するスキルシートの上限（初回の大量取り込みは複数回に分けて進む）
PROPER_MAX_EXTRACT_PER_RUN=20
# 突合する案件の受信日の遡り日数
PROPER_PROJECT_LOOKBACK_DAYS=14
# フォルダ内の「ファイルへのショートカット」の参照先も読むか（既定 false。フォルダへのショートカットはたどらない）。
# true にすると、フォルダにファイルを追加できる人は、プロパーの認証で読める任意のファイルを読み取らせられる点に注意
PROPER_FOLLOW_SHORTCUTS=false

# Notion: 案件DB / 要員DB / マッチ結果DB（database_id。起動時にdata_source_idへ自動解決）
NOTION_PROJECT_DB_ID=
NOTION_ENGINEER_DB_ID=
NOTION_MATCH_DB_ID=
# Notion: 自社社員DB（候補要員→案件探し機能。npm run ses:own-match で参照）
NOTION_OWN_ENGINEER_DB_ID=
# Notion: マッチ評価ログDB（複数人の妥当/ズレ評価の共有の正）
NOTION_FEEDBACK_DB_ID=
# Notion: スキル同義辞書DB（人のフィードバックで育てる共有辞書）
NOTION_SKILL_EQUIV_DB_ID=
# マッチ確認UI（npm run ses:web）の待受ポート。既存の web(8787) と衝突しないよう既定8788
SES_WEB_PORT=8788
# 確認UIの待受ホスト。複数人でLAN共有する場合は 0.0.0.0 等（WEB_ACCESS_TOKEN と、HTTPS＝下の証明書・鍵
# または SES_WEB_BEHIND_TLS=true の両方が必要。平文HTTPではトークンと個人情報が同じネットワークから読めるため）。既定はローカルのみ
SES_WEB_HOST=127.0.0.1
# 確認UIを HTTPS で待ち受ける証明書・秘密鍵（PEMファイルのパス。両方指定したときだけ HTTPS）
SES_WEB_TLS_CERT=
SES_WEB_TLS_KEY=
# HTTPS のリバースプロキシ・VPN の内側でだけ公開している場合に true（平文HTTPのままループバック以外で待ち受ける）
SES_WEB_BEHIND_TLS=
# 確認UIのアクセストークンは上部の WEB_ACCESS_TOKEN を使用（chat UI と共通）。
# ※ここで再宣言しないこと — dotenvは後勝ちのため、空で再宣言すると上部の設定値が消えて認証が無効になる
# 確認UIが読み書きするレビュー用ローカルJSONの置き場（バッチ/自社社員探しの成果を保存）。
# 未設定なら本番は data/ses-review、demo は data/ses-demo/review（demoのfixtureを本番のレビューに混ぜない）
# SES_REVIEW_DATA_DIR=data/ses-review
# 段階別モデル（抽出=Haiku・最終判定/メール生成=Sonnet。切替可能）
# 単価（per MTok）: Haiku 4.5 = $1/$5、Sonnet 5 = $2/$10（2026-09-23 確認）。キャッシュは入力単価の 1.25倍（5分書込）・2倍（1時間書込）・0.1倍（読込）
# Haiku 4.5 は 2026-10-15 より後に退役予定（Anthropic 公表）。抽出モデルが使えなくなると、その実行の残りの抽出を
# ANTHROPIC_MODEL_MATCH のモデルで代替し（費用増）、サマリに「抽出モデルが利用できないため判定モデルで代替（費用増）」と載せる。
# 後継のモデルが決まったら ANTHROPIC_MODEL_EXTRACT をそのIDに変更する（Haiku 系には adaptive thinking・effort を付けない）
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5
ANTHROPIC_MODEL_MATCH=claude-sonnet-5
# --- 自動検証・自己修復（うまく動かない時の検証・修正を一定のAPI予算内で自動化） ---
# 失敗時の再試行・上位モデル昇格・隔離を行うか（既定ON。予算で拘束される）
SES_HEAL_ENABLED=true
# 1バッチあたり自動修復に使ってよいLLMコスト上限（円）。超えたら打ち切り次回バッチへ繰越
SES_HEAL_BUDGET_JPY=50
# 同一メールの累計失敗回数がこの値に達したら隔離（無限再試行の打ち切り）
SES_HEAL_MAX_ATTEMPTS=3
# 隔離リスト・診断ログのローカル置き場（DB_PROVIDER=sheets の本番では隔離リストはシートの「_状態」タブ）
# SES_HEAL_DATA_DIR=data/ses-heal
# 円換算レート（コスト概算・予算判定に使用）
JPY_PER_USD=160
# バッチ末尾での「修正パッチ案」自動生成（ソースコードをAPIへ送るためopt-in。手動は npm run ses:repair）
SES_REPAIR_ENABLED=false
# パッチ案生成1回あたりのLLMコスト上限（円）
SES_REPAIR_BUDGET_JPY=100
# ログ秘匿（氏名・メールアドレス・件名・API生エラー文をコンソールに出さない）。
# 未設定なら CI / GitHub Actions 上で自動的に有効（公開リポジトリのログ対策）。true/false で明示指定可
# （ワークフローは true 固定。npm run ses:preflight は GitHub Actions 上で false だとエラーにする）
SES_LOG_REDACT=
# パッチ案生成に使うモデル（未設定なら ANTHROPIC_MODEL_MATCH と同じ）
# ANTHROPIC_MODEL_REPAIR=

# trueでBatch API（50%割引）を使用。Phase3で参照（現状未使用の予約設定）
USE_BATCH_API=false
# trueで強制demo（ANTHROPIC_API_KEYの有無に関わらず外部呼び出しゼロで実行）
DEMO_MODE=false

# --- 本番導入の補助 ---
# メール量の測定（npm run ses:mail-stats / GitHub Actions の「SESメール量の測定」）で遡る日数（1〜365）。
# 受信箱を読み取り専用で開き、件数・時間帯・添付の種類などの集計値とLLM費用の概算だけを表示する（LLMの鍵は不要）
SES_STATS_DAYS=30
